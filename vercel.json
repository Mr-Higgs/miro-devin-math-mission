{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": { "root": "site", "framework": "nextjs" },
    "web": { "root": "web", "framework": "nextjs" }
  },
  "rewrites": [
    { "source": "/app", "destination": { "service": "web" } },
    { "source": "/app/(.*)", "destination": { "service": "web" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ]
}
