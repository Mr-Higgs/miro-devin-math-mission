# Which AI provider answers the app's calls. "mock" works with no keys.
AI_PROVIDER=mock

# Optional: override the provider's default model.
AI_MODEL=

# Keys for real providers (only the chosen one is needed).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: where session data is stored (default: ./data).
DATA_DIR=
