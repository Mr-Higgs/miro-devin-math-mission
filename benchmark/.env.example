# Copy this file to .env and paste your keys after the = signs.
# .env is never shared or committed. Leave a line blank to skip that provider.

# Anthropic (Claude): console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# OpenAI: platform.openai.com → API keys
OPENAI_API_KEY=

# Google (Gemini): aistudio.google.com → Get API key
# Use a project with billing turned on: free-tier data may be used to improve Google's products (decision 006).
GEMINI_API_KEY=
