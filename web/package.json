{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bench": "tsx benchmark/src/run.ts",
    "bench:models": "tsx benchmark/src/list-models.ts",
    "db:new": "npx --yes supabase@2.121.0 --workdir .. migration new",
    "db:status": "npx --yes supabase@2.121.0 --workdir .. migration list --linked",
    "db:test": "node ../supabase/tests/privacy.test.mjs ../supabase/migrations",
    "db:push": "npx --yes supabase@2.121.0 --workdir .. db push --linked",
    "db:types": "npx --yes supabase@2.121.0 --workdir .. gen types typescript --linked > src/lib/supabase/database.types.ts",
    "invite": "tsx scripts/invite.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.3.16",
    "@next/env": "^16.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
