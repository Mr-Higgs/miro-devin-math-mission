# Copy to .env.local and fill in. .env.local is git-ignored; this file is not,
# so never put real values here.

# Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never add NEXT_PUBLIC_ to this one.
SUPABASE_SECRET_KEY=

# AI providers (server only). Gemini is the app's provider (decision 002);
# the other two are only for comparing models with the benchmark.
# Google: use a project with billing on (free-tier data may train Google's models; decision 006).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
